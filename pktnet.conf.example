# PKTNET bot configuration
# Copy to /etc/pktnet/pktnet.conf and fill in your passcode (can be obtained at aprs.dvbr.net).
# Keep the real file out of your git repository (it holds the passcode).

[aprsis]
# A tier-2 rotate works; for Brazil you may prefer a regional pool.
server = firenet.us
port = 14580

# Verified login identity for the connection. The passcode is derived from
# the BASE callsign (PP5PK), so it is the same with or without the SSID.
login_call = PP5PK-3
passcode = 00000

# The special net callsign users address their messages to.
net_call = PKTNET

[net]
# When true, check-ins only count while an event window is active
# (register windows with: pktnet_bot.py addevent ...).
# When false, the bot auto-creates a daily ad-hoc event and always logs.
require_active_event = true

# Reply templates. Placeholders: {time} = HHMM UTC, {call}, {event}.
# Keep each under 67 characters; PP5PK is included for station ID.
confirm_text = Check-in OK {time}z. 73 de PP5PK
dup_text     = Already registered {time}z. 73 de PP5PK
closed_text  = PKTNET not active. 73 de PP5PK
paused_text  = PKTNET under maintenance, try again in a few minutes.

# Callsigns allowed to send ADMIN remote-control commands to the net callsign
# (matched by base call, SSID ignored). Leave empty to disable admin commands.
#   Public  (anyone):  CHECK_#, CHECK_LAST, CHECK_TIME, CHECK_ME, CHECK_HELP
#   Admin   (below):   CHECK_USERS, CHECK_START, CHECK_STOP, CHECK_PAUSE,
#                      CHECK_RESTART
admin_calls = PP5MFA

[room]
# Optional group-chat room. Users send a message to this callsign; anything a
# member sends is relayed to all other members. Leave room_call empty to
# disable the room. Commands (to room_call): JOIN, LEAVE, WHO, HELP.
room_call = PKTQSO
# Drop members with no activity for this many minutes.
timeout_min = 1440
# Maximum members in the room.
max_members = 50
# Minimum seconds between a member's relayed messages (flood guard).
min_interval = 10

[messaging]
max_retries = 3
retry_interval = 30
keepalive_interval = 20
rx_timeout = 90

[db]
path = /var/lib/pktnet/pktnet.db
